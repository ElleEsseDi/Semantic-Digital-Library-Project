lsd:Entity_51275 a lsd:Context_narration ;
    rdfs:label "The 2015 World Youth Championships in Athletics was the ninth edition of the biennial international athletics competition for youth (under_18) athletes. The five_day competition took place between 15 July 2015 and 19 July at the Estadio Olímpico Pascual Guerrero stadium in Cali, Colombia." .

lsd:Entity_51287 a lsd:Context_narration ;
    rdfs:label "The Woolfire Festival was an annual music festival held since 2005 on a former sheep farm in Woodmancott, Hampshire, England." .

lsd:Entity_51324 a lsd:Context_narration ;
    rdfs:label "The 2015–16 W_League was the eighth season of the W_League, the Australia national women's association football competition. League newcomers Melbourne City FC W_League claimed both the regular season Premiership and end of season Championship, the latter awarded for their victory in the 2016 W_League Grand Final." .

lsd:Entity_51330 a lsd:Context_narration ;
