lsd:Entity_53597 a lsd:Context_narration ;
    rdfs:label "The 1949 Memorial Cup final was the 31st junior ice hockey championship of the Canadian Amateur Hockey Association. The George Richardson Memorial Trophy champions Montreal Royals of the Quebec Junior Hockey League in Eastern Canada competed against the Abbott Cup champions Brandon Wheat Kings of the Manitoba Junior Hockey League in Western Canada. In a best_of_seven series, held at Shea's Amphitheatre in Winnipeg, Manitoba and the Wheat City Arena in Brandon, Manitoba, Montreal won their 1st Memorial Cup, defeating Brandon 4 games to 3, with 1 tied game." .

lsd:Entity_53613 a lsd:Context_narration ;
