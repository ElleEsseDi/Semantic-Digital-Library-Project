lsd:Entity_56753 a lsd:Context_narration ;
    rdfs:label "The 19th Tony Awards was broadcast on 1965, from The Hotel Astor in New York City on local television station WWOR_TV (Channel 9)." .

lsd:Entity_56768 a lsd:Context_narration ;
    rdfs:label "1951 Svenska Cupen was the eleventh season of the main Sweden association football Cup. The competition was concluded on 22 July 1951 with the 1951 Svenska Cupen Final, held at Råsunda Stadium, Solna in Stockholms län. The 1951 Svenska Cupen Final was played on 22 July 1951 at the Råsunda Stadium." .

lsd:Entity_56770 a lsd:Context_narration ;
    rdfs:label "The 1933 Open Championship was the 68th The Open Championship, held 5 July–8 July at the Old Course at St Andrews in St Andrews. This was the first playoff at the Open in a dozen years, since 1921, also won by an American at St Andrews; Jock Hutchison (1884–1977) was born in Scotland but became a U.S. citizen the previous year. The Old Course at St Andrews was par 73 in 1933; the #17 Road Hole was a par_5 through the 1946 Open." .

lsd:Entity_56802 a lsd:Context_narration ;
    rdfs:label "Battle of Barnaul was a series of conflicts during the Russian Civil War from 13 June 1918–15, 1918, involving different factions in the Siberian region." .

lsd:Entity_56809 a lsd:Context_narration ;
    rdfs:label "Battleground was a professional wrestling pay_per_view (PPV) event produced by WWE. It took place on 06 October 2013 at the First Niagara Center in Buffalo, New York. The professional wrestling matches at Battleground featured professional wrestlers performing as characters in scripted events pre_determined by the hosting promotion, WWE." .

lsd:Entity_56818 a lsd:Context_narration ;
    rdfs:label "Tropical Storm Wendy, known in the Philippines as Tropical Storm Mameng, was a deadly tropical cyclone that affected China in early 04 September 1999." .

lsd:Entity_56857 a lsd:Context_narration ;
