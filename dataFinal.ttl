lsd:Entity_5743 a lsd:Context_narration ;
    rdfs:label "The 1997 NCAA Rowing Championships were contested at the first annual NCAA_sanctioned regatta to determine the team national champions of women's rowing in the United States of America during the. This year's regatta was held on 31 May 1997 at Lake Natoma near Rancho Cordova." .

lsd:Entity_57454 a lsd:Context_narration ;
