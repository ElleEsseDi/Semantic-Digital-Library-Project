lsd:Entity_53754 a lsd:Context_narration ;
    rdfs:label "A by_election was held for the South Australian House of Assembly seat of 1892 East Adelaide colonial by_election on 23 January 1892. The 1892 1892 East Adelaide colonial by_election by_election saw ULP candidate John McPherson win the seat." .

