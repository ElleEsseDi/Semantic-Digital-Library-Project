lsd:Entity_14760 a lsd:Context_narration ;
    rdfs:label "The 2016 Minnesota House of Representatives election was held in the U.S. state of Minnesota on 08 November 2016, to elect members to the House of Representatives of the 90th Minnesota Legislature. The 2014 Minnesota House of Representatives election resulted in the Republican Party of Minnesota winning a majority of seats, after losing a majority to the Minnesota Democratic–Farmer–Labor Party (DFL) only two years earlier in the previous election." .

lsd:Entity_14763 a lsd:Context_narration ;
