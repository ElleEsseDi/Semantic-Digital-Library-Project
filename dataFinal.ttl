lsd:Entity_43902 a lsd:Context_narration ;
    rdfs:label "The 2009 BNP Paribas Primrose Bordeaux was a professional tennis tournament played on outdoor red clay courts. It took place in Bordeaux, France between 11 May 2009 and 17 May 2009." .

