ns1:60252 a ns1:context_narration ;
    rdfs:label "The 1993–94 EHF Women's Champions League was the first edition of the EHF Women's Champions League, the premier European women's club handball tournament, being organized by the European Handball Federation." .

ns1:60256 a ns1:context_narration ;
    rdfs:label "The 1999 Heineken Cup Final was the final match of the 1998–99 Heineken Cup, the fourth season of Europe's top club rugby union competition. The match was played on 1999 at Lansdowne Road in Dublin." .

ns1:60268 a ns1:context_narration ;
