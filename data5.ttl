ns1:44879 a ns1:context_narration ;
    rdfs:label "The 2015 Trafford Metropolitan Borough Council election is scheduled to take place on 07 May 2015 to elect members of Trafford Metropolitan Borough Council in England." .

ns1:44883 a ns1:context_narration ;
