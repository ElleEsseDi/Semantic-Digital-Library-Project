    rdfs:label "The 1971 Ohio State Buckeyes football team represented the Ohio State University in the 1971 Big Ten Conference football season." .

ns1:41369 a ns1:context_narration ;
    rdfs:label "The 1975–76 Ranji Trophy was the 42nd season of the Ranji Trophy." .

