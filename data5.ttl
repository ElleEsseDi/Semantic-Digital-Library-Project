ns1:46883 a ns1:context_narration ;
    rdfs:label "Battle of Shinanah was a major battle of the Saudi–Rashidi War, during the Unification of Saudi Arabia campaign, between Rashidi and Saudi rebels. It occurred on 29 September 1904, in town of Shinanah in Al-Qassim Region." .

ns1:46897 a ns1:context_narration ;
