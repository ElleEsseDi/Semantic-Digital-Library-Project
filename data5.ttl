ns1:47779 a ns1:context_narration ;
    rdfs:label "The Café Apropo bombing was a Palestinian suicide bombing which occurred on 21 March 1997 in a coffee shop in Tel Aviv. The attack occurred on 21 March 1997, on the eve of the Purim holiday, at around 13:40, when a Palestinian suicide attack detonated an explosive device which was concealed in a handbag in the entrance to the coffee shop \"Apropo\" in Tel Aviv." .

ns1:47780 a ns1:context_narration ;
